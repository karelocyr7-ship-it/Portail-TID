# Ne jamais mettre de valeur réelle dans ce fichier.
NODE_ENV=development
TZ=Africa/Abidjan
PORTAL_PUBLIC_URL=https://portail.tadgroupe.com
KEYCLOAK_PUBLIC_URL=https://portail.tadgroupe.com/auth
DATABASE_URL=postgresql://portal_user:CHANGE_ME@postgres:5432/portal
KEYCLOAK_DATABASE_URL=postgresql://keycloak_user:CHANGE_ME@postgres:5432/keycloak
N8N_DATABASE_URL=postgresql://n8n_user:CHANGE_ME@postgres:5432/n8n
KEYCLOAK_CLIENT_ID=tad-portal
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
# Client confidentiel dédié au provisioning des utilisateurs Keycloak.
KEYCLOAK_ADMIN_CLIENT_ID=tad-portal-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
# Signature HMAC du flux d’onboarding SIRH vers le portail.
SIRH_PROVISIONING_SECRET=CHANGE_ME
SIRH_PROVISIONING_MAX_SKEW_SECONDS=300
DRIVE_PROVISIONING_URL=https://drive.sirh.tadgroupe.com/api/method/hrms_fr_ci_drive.api.sync_employee
DRIVE_PROVISIONING_TOKEN=CHANGE_ME
# Connecteurs applicatifs optionnels. Chaque application doit exposer le
# contrat POST /api/provisioning/users avec le même en-tête HMAC. Tant que
# l’URL et le secret ne sont pas renseignés, les jobs restent en attente sans
# perturber l’ancien flux OIDC/local.
TDB_PROVISIONING_URL=
TDB_PROVISIONING_TOKEN=CHANGE_ME
CASH_RECON_PROVISIONING_URL=
CASH_RECON_PROVISIONING_TOKEN=CHANGE_ME
REVUE_PDV_PROVISIONING_URL=
REVUE_PDV_PROVISIONING_TOKEN=CHANGE_ME
GPARC_PROVISIONING_URL=
GPARC_PROVISIONING_TOKEN=CHANGE_ME
ATF_PROVISIONING_URL=
ATF_PROVISIONING_TOKEN=CHANGE_ME
MDM_PROVISIONING_URL=
MDM_PROVISIONING_TOKEN=CHANGE_ME
SIRH_PROVISIONING_URL=
SIRH_PROVISIONING_TOKEN=CHANGE_ME
RECRUTEMENT_PROVISIONING_URL=
RECRUTEMENT_PROVISIONING_TOKEN=CHANGE_ME
KEYCLOAK_ISSUER=https://portail.tadgroupe.com/auth/realms/tad-groupe
SESSION_SECRET=CHANGE_ME_WITH_32_OR_MORE_RANDOM_BYTES
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_32_OR_MORE_RANDOM_BYTES
ACME_EMAIL=karelocyr7@gmail.com
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
PORTAL_DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
KEYCLOAK_DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
N8N_DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
KEYCLOAK_ADMIN_USERNAME=kc_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
