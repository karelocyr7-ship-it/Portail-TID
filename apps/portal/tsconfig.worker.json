{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".worker-dist",
    "rootDir": "./lib",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "verbatimModuleSyntax": false,
    "allowJs": true
  },
  "include": [
    "lib/email/worker-entry.ts",
    "lib/email/**/*.ts",
    "lib/provisioning/worker-entry.ts",
    "lib/provisioning/**/*.ts",
    "lib/prisma.ts",
    "lib/application-profile-priority.js"
  ]
}
