<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
 <changeSet id="tad-initial-access-1" author="tad">
  <createTable tableName="TAD_INITIAL_ACCESS">
   <column name="USER_ID" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="REALM_ID" type="VARCHAR(36)"><constraints nullable="false"/></column>
   <column name="OPERATION_ID" type="VARCHAR(36)"/>
   <column name="GENERATION" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
   <column name="CREDENTIAL_ID" type="VARCHAR(36)"/>
   <column name="CREDENTIAL_VERSION" type="INT"/>
   <column name="ACTIVATED" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
  </createTable>
 </changeSet>
</databaseChangeLog>
