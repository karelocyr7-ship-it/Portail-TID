[Unit]
Description=Agent Codex local pour %I — Portail TAD
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tad-agents/%i.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/srv/tad/agents
ExecStart=/usr/bin/env node /srv/tad/agents/portal-local-agent.mjs
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tad/agents
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=2G
CPUQuota=200%
UMask=0077

[Install]
WantedBy=multi-user.target
