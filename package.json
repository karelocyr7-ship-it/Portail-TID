      "sharp": "0.35.4",
      "postcss": "8.5.18",
      "fast-uri": "3.1.6",
      "nanoid": "3.3.18",
      "deepmerge-ts": "8.0.0",
      "mysql2": "3.22.0"
    }
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
